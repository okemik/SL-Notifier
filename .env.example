# Telegram credentials (required)
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
TELEGRAM_CHAT_ID=123456789

# Polling starts immediately, then repeats after each check.
# Minimum 60000 ms, including authenticated manual requests.
CHECK_INTERVAL_MS=60000
TRANSPORT_MODE=METRO
LINES=17,18,19
FUTURE=false

# Display and translation. Only Swedish-to-English automatic translation is supported.
TZ=Europe/Stockholm
PREFERRED_LANG=sv
TRANSLATE_ENABLED=true

# State is for one Telegram destination. Docker Compose overrides this path.
STATE_DB=state.db
PRUNE_DAYS=14

PORT=3000
# Optional. Empty disables /check. Use a long random secret; send it in the Authorization header.
CHECK_API_KEY=
